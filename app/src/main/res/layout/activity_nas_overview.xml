<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <Button android:minHeight="48dp" android:id="@+id/overview_back" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/overview_back" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/overview_title" android:textColor="@color/text_primary" android:textSize="28sp" />
        <TextView android:id="@+id/overview_route" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:textIsSelectable="true" />
        <TextView android:id="@+id/overview_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textColor="@color/brand_mint" android:textSize="18sp" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/overview_metrics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:padding="18dp" android:background="@drawable/card"
            android:textColor="@color/text_body" android:textSize="15sp" android:lineSpacingExtra="7dp" />
        <Button android:minHeight="48dp" android:id="@+id/overview_refresh" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/overview_refresh" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
        <LinearLayout android:id="@+id/overview_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/overview_readonly" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
