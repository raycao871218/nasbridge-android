<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/network_scroll" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <Button android:minHeight="48dp" android:id="@+id/back_button" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/back" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_title" android:textSize="30sp" android:textColor="@color/text_primary" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_subtitle" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/ssid_label" android:textColor="@color/text_body"
            android:textSize="14sp" android:labelFor="@+id/ssid" />
        <EditText android:minHeight="56dp" android:id="@id/ssid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp"
            android:hint="@string/ssid_hint" android:inputType="text" android:singleLine="true"
            android:importantForAutofill="no" />
        <Button android:minHeight="48dp" android:id="@+id/read_wifi_button" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/read_wifi" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/permission_note" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/local_label" android:textColor="@color/text_body"
            android:textSize="14sp" android:labelFor="@+id/local_host" />
        <EditText android:minHeight="56dp" android:id="@id/local_host" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp"
            android:hint="@string/local_hint" android:inputType="textUri" android:singleLine="true"
            android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/local_port_label" android:textColor="@color/text_body"
            android:textSize="14sp" android:labelFor="@+id/local_port" />
        <EditText android:minHeight="56dp" android:id="@id/local_port" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp"
            android:hint="@string/port_hint" android:inputType="number" android:singleLine="true"
            android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/public_label" android:textColor="@color/text_body"
            android:textSize="14sp" android:labelFor="@+id/public_host" />
        <EditText android:minHeight="56dp" android:id="@id/public_host" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp"
            android:hint="@string/public_hint" android:inputType="textUri" android:singleLine="true"
            android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/public_port_label" android:textColor="@color/text_body"
            android:textSize="14sp" android:labelFor="@+id/public_port" />
        <EditText android:minHeight="56dp" android:id="@id/public_port" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp"
            android:hint="@string/port_hint" android:inputType="number" android:singleLine="true"
            android:importantForAutofill="no" />
        <Button android:minHeight="56dp" android:id="@+id/save_button" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:background="@drawable/button" android:text="@string/save_hosts"
            android:textColor="@color/ink_on_accent" android:stateListAnimator="@null" />
        <Button android:minHeight="48dp" android:id="@+id/refresh_button" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/refresh_hosts" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card" android:padding="18dp" android:layout_marginTop="16dp">
            <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/brand_mint" android:textSize="20sp" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/connection_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/text_body" android:textSize="13sp" android:lineSpacingExtra="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/active_host_label" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/active_host" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/brand_mint" android:textSize="18sp" android:textIsSelectable="true" />
            <TextView android:id="@+id/route_reason" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/text_body" android:textSize="13sp" android:lineSpacingExtra="4dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/routing_rules" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:lineSpacingExtra="5dp" />
    </LinearLayout>
</ScrollView>
