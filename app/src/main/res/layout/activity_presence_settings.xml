<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<Button android:id="@+id/presence_back" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/back" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/presence_title" android:textColor="@color/text_body" android:textSize="28sp" android:lineSpacingExtra="5dp" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/presence_help" android:textColor="@color/text_body" android:textSize="14sp" android:lineSpacingExtra="5dp" />
<TextView android:id="@+id/geofence_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/text_body" android:textSize="14sp" android:lineSpacingExtra="5dp" />
<Button android:id="@+id/geofence_refresh" android:layout_width="match_parent" android:layout_height="56dp" android:text="同步 NAS 围栏配置" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<Switch android:id="@+id/presence_test_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
    android:layout_marginTop="16dp" android:text="@string/presence_test_mode" android:textColor="@color/text_body" android:textSize="14sp" android:paddingVertical="8dp" />
<Button android:id="@+id/presence_test_now" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/presence_test_now" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<TextView android:id="@+id/presence_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/presence_initial" android:textColor="@color/text_body" android:textSize="14sp" android:lineSpacingExtra="5dp" />
<Button android:id="@+id/presence_network_settings" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/network_settings_entry" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/presence_permission_note" android:textColor="@color/text_body" android:textSize="13sp" android:lineSpacingExtra="5dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ha_url_label" android:textColor="@color/text_body" />
<EditText android:id="@+id/ha_url" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp" android:hint="@string/ha_url_hint" android:inputType="textUri" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ha_entity_label" android:textColor="@color/text_body" />
<EditText android:id="@+id/ha_entity" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp" android:hint="@string/ha_entity_label" android:inputType="text" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ha_token_label" android:textColor="@color/text_body" />
<EditText android:id="@+id/ha_token" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/card" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="14sp" android:hint="@string/ha_token_hint" android:inputType="textPassword" android:singleLine="true" android:importantForAutofill="no" android:saveEnabled="false" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/presence_token_note" android:textColor="@color/text_body" android:textSize="13sp" android:lineSpacingExtra="5dp" />
<Button android:id="@+id/presence_start" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/presence_start" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<Button android:id="@+id/presence_stop" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/presence_stop" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<Button android:id="@+id/presence_permissions" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/presence_permissions" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<Button android:id="@+id/presence_battery_settings" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/presence_battery_settings" android:textColor="@color/brand_mint" style="?android:attr/borderlessButtonStyle" />
<TextView android:id="@+id/presence_background_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/text_body" android:textSize="13sp" android:lineSpacingExtra="5dp" />
<TextView android:id="@+id/presence_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/presence_initial" android:textColor="@color/text_body" android:textSize="18sp" android:lineSpacingExtra="5dp" />

</LinearLayout></ScrollView>