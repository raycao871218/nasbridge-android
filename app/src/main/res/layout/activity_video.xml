<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:background="@color/player_background">
    <FrameLayout android:id="@+id/video_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="112dp" android:layout_marginBottom="148dp">
        <SurfaceView android:id="@+id/video_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:contentDescription="视频画面：左右滑动调整进度，左侧上下调整亮度，右侧上下调整音量，轻触显示播放控制" />
    </FrameLayout>
    <LinearLayout android:id="@+id/video_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/video_back" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/video_back" android:textColor="@color/player_accent" style="?android:attr/borderlessButtonStyle" />
        <TextView android:id="@+id/video_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:textSize="18sp" android:textColor="@android:color/white" />
    </LinearLayout>
    <LinearLayout android:id="@+id/video_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="@color/player_controls" android:padding="8dp">
        <TextView android:id="@+id/video_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/video_loading" android:textColor="@color/player_accent" android:accessibilityLiveRegion="polite" />
        <SeekBar android:id="@+id/video_seek" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/video_progress" android:enabled="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <Button android:id="@+id/video_play" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/video_play" android:enabled="false" />
            <TextView android:id="@+id/video_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/video_time_initial" android:textColor="@android:color/white" />
            <Button android:id="@+id/video_speed" android:layout_width="64dp" android:minWidth="48dp" android:layout_height="48dp" android:padding="0dp" android:text="@string/video_speed_default" android:enabled="false" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/video_gesture_feedback" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:padding="18dp" android:background="@drawable/card" android:textColor="@color/brand_blue" android:textSize="18sp" android:gravity="center" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/video_fullscreen" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="top|end" android:layout_margin="8dp" android:minWidth="104dp" android:paddingHorizontal="12dp"
        android:drawableStart="@drawable/ic_fullscreen" android:drawablePadding="8dp" android:text="@string/video_fullscreen"
        android:textColor="@color/brand_blue" android:textSize="14sp" android:background="@drawable/card" android:stateListAnimator="@null" />
</FrameLayout>
